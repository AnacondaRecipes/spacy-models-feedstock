#
# PBP CI: graph-submitter Lambda times out (~15 min) during `pbp generate
# from-feedstock` for this feedstock (~500 tasks). If PR CI stays pending on
# graph-submitter, generate and submit the graph locally instead:
#
#   pbp generate from-feedstock \
#     --output /tmp/spacy-models-feedstock.yaml \
#     --custom-metadata-file /tmp/custom_metadata.yaml .
#   pbp graph create -f /tmp/spacy-models-feedstock.yaml --with-linter
#
# For PR checks on manual submit, custom_metadata.yaml needs:
#   repository_name, git_sha1, pr_number, pr_merged
#
# Rebuilds: edit BUILD_NUMBER in _update_spacy_recipe.py, run that script,
# commit the regenerated meta.yaml (not a hand edit here).
#
# PBP graph wiring: Jinja {% if spacy_lang %} output groups prevent conda-build
# from including spacy_lang in get_used_vars() for _lg/_md outputs (only _sm).
# PBP then links all lg/md tests to the ca build batch. force_use_keys below
# keeps spacy_lang in each output's variant so tests depend on the right build.

{% set version = "<< version >>" %}
# see https://github.com/explosion/spacy-models/blob/master/compatibility.json
# but the pattern _generally_ seems to be x.x
{% set spacy = "==" + (".".join(version.split(".")[:2])) + ".*" %}

package:
  name: spacy-models
  version: {{ version }}

source:
  - url: https://raw.githubusercontent.com/explosion/spaCy/master/LICENSE
    sha256: 3f4378e67708fecacd3e27651c8bc0f977cf20789e19da0d81a2840e7cf573a2
<% for lang, metas in lang_metas.items() %>
{% if spacy_lang == "<< lang >>" <% if not loop.index0 %> or not (spacy_lang is defined) <% endif %>%}
<%- for p, m in metas.items() %>
  - url: https://github.com/explosion/spacy-models/releases/download/<<m.lang >>_<< m.name >>-{{ version }}/<< m.lang >>_<< m.name >>-{{ version }}.tar.gz
    sha256: << m.checksum >>
    folder: <<m.lang >>_<< m.name >>
<% endfor -%>
{% endif %}  # << lang >>
<% endfor %>

build:
  noarch: python
  number: << build_number >>

requirements:
  host:
    - python
    - pip
    - setuptools
    - wheel
  run:
    - python >=3.9

test:
  commands:
    - echo "tests in subdir"

outputs:
<% for lang, metas in lang_metas.items() %>
{% if spacy_lang == "<< lang >>" <% if not loop.index0 %> or not (spacy_lang is defined) <% endif %>%}
<%- for p, m in metas.items() %>
  - name: spacy-model-<< m.lang >>_<< m.name >>
    build:
      force_use_keys:
        - spacy_lang
      noarch: python
      script:
        - cd << m.lang >>_<< m.name >> && {{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation
    requirements:
      host:
        - python
        - pip
        - setuptools
        - wheel
      run:
        - python >=3.9
        - spacy {{ spacy }}<% for req in m.requirements %>
        - << reqtify(req)  >>
        <%- endfor %>
    test:
      imports:
        - << m.lang >>_<< m.name >>
      requires:
        - pip
<% if needs_setuptools(m.requirements) %>
        - setuptools <82
<% endif %>
      commands:
        <%- if skip_pip_check.get(m.lang, {}).get(m.name) %>
        # TODO: fix pip check
        #       << skip_pip_check.get(m.lang, {}).get(m.name) >>
        <% else %>
        - pip check
        <% endif -%>
        - python -c "__import__('<< m.lang >>_<< m.name >>').load()"
        - python -c "__import__('spacy').load('<< m.lang >>_<< m.name >>')"
    about:
      summary: << m.description.split(". ", 1)[0].strip() >>.
      description: |-
        << m.description.split(". ", 1)[1].strip() >>
      license_file:
        - << m.lang >>_<< m.name >>/LICENSE
        - << m.lang >>_<< m.name >>/LICENSES_SOURCES
      license: << m.license >>
<% endfor -%>
{% endif %}  # << lang >>
<% endfor %>

